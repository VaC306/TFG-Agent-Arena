{
  "name": "agent-arena-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "start": "ng serve --host 127.0.0.1 --proxy-config proxy.conf.json",
    "build": "ng build",
    "test": "node --test tests/*.test.cjs",
    "e2e": "node e2e/run.cjs",
    "e2e:repeat": "node e2e/run.cjs --repeat-each=3",
    "e2e:typecheck": "tsc --noEmit -p e2e/tsconfig.json",
    "e2e:install": "playwright install chromium",
    "start:demo": "ng serve --configuration demo --host 127.0.0.1",
    "build:demo": "ng build --configuration demo",
    "test:demo": "node demo-tests/browser.cjs"
  },
  "engines": {
    "node": "^20.19.0 || ^22.12.0 || ^24.0.0"
  },
  "dependencies": {
    "@angular/common": "20.3.33",
    "@angular/compiler": "20.3.33",
    "@angular/core": "20.3.33",
    "@angular/forms": "20.3.33",
    "@angular/platform-browser": "20.3.33",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "20.3.39",
    "@angular/cli": "20.3.39",
    "@angular/compiler-cli": "20.3.33",
    "@playwright/test": "1.64.0",
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
